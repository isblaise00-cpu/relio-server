# Port HTTP du serveur
PORT=3000

# --- Connexion MySQL ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smspay

# production | development
NODE_ENV=development

#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-moi-avec-un-long-jeton-aleatoire


DEFAULT_COUNTRY_CODE=226
SIGNATURE_TOLERANCE_S=300
HOLD_SECONDS=120
DEVICE_OFFLINE_AFTER_S=1800
WORKER_INTERVAL_MS=2000
MATCH_CLOCK_SKEW_S=120
INTENT_DEFAULT_TTL_S=900
MAX_AMOUNT=2000000
WEBHOOK_TIMEOUT_MS=10000

# --- SMS Gateway for Android -------------------------------------------------
# URL publique HTTPS du serveur, utilisée pour fabriquer les URL de webhook à saisir
# dans l'appli SMS Gateway (ex. https://pay.mondomaine.bf). SMS Gateway exige le HTTPS.
PUBLIC_BASE_URL=

# --- Sécurité ----------------------------------------------------------------
# Derrière Nginx/Caddy, mettre 1 pour que le serveur voie la vraie IP et le https.
# TRUST_PROXY=1

# Autoriser les webhooks vers des adresses internes (localhost, 192.168.x…).
# Par défaut : oui en développement, NON en production (protection SSRF).
# ALLOW_PRIVATE_WEBHOOKS=false

# --- Base de données de test (pour npm test) ---------------------------------
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=
# TEST_DB_NAME=smspay_test
